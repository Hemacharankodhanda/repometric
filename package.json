{
  "name": "repo-analyzer-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "pnpm --filter @repometric/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "db:types": "node scripts/generate-db-types.mjs",
    "verify:github": "node scripts/verify-github.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.4"
  }
}
