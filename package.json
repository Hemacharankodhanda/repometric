{
  "name": "repometric",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic 0-100 GitHub repository health scoring, zoomable repo treemap, and interactive dependency visualizers.",
  "author": "Hemacharan Kodhanda",
  "license": "MIT",
  "homepage": "https://github.com/Hemacharankodhanda/repometric#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hemacharankodhanda/repometric.git"
  },
  "bugs": {
    "url": "https://github.com/Hemacharankodhanda/repometric/issues"
  },
  "keywords": [
    "github",
    "health-score",
    "code-quality",
    "treemap",
    "dependency-graph",
    "repometric",
    "static-analysis",
    "architecture-diagram"
  ],
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "pnpm --filter @repometric/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "db:types": "node scripts/generate-db-types.mjs",
    "verify:github": "node scripts/verify-github.mjs",
    "cli": "tsx packages/cli/src/index.ts",
    "repometric": "tsx packages/cli/src/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.4"
  }
}
