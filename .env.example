# Copy to apps/web/.env.local and fill in. Never commit the real file.

# GitHub fine-grained token, public repositories read-only (server only)
GITHUB_TOKEN=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=        # server only, never expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authorizes /api/cron/keepalive (any long random string)
CRON_SECRET=
